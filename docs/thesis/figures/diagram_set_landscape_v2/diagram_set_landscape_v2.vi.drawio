        </mxCell>
        <mxCell id="part-52" value="&lt;div style=&quot;line-height:130%&quot;&gt;KLTN-Lon2G · 09/11/2026 · Số vàng là mã khối trong hình, không phải số hình của báo cáo.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#526577;">
