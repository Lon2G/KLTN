        </mxCell>
        <mxCell id="part-50" value="&lt;div style=&quot;line-height:130%&quot;&gt;So sánh seller/khu vực phải kèm số đơn, mẫu số, bối cảnh và giới hạn; không quy kết nguyên nhân.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#526577;">
