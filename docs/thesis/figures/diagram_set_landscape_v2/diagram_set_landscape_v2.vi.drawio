        </mxCell>
        <mxCell id="part-51" value="&lt;div style=&quot;line-height:130%&quot;&gt;Không tuyên bố mọi chức năng phân tích sâu hoặc hiệu quả quản trị đã được hoàn thiện / kiểm chứng.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#526577;">
