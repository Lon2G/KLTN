        </mxCell>
        <mxCell id="part-49" value="&lt;div style=&quot;line-height:130%&quot;&gt;Đã có bản local; chỉ hiển thị giải thích AI với đầu ra đã qua kiểm tra. Kết quả lấy từ hồ sơ đã lưu.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#526577;">
