        <mxCell id="technical" value="&lt;b&gt;&lt;font style=&quot;font-size:18.0px&quot;&gt;Kiểm chứng kỹ thuật — pilot&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;Khớp nguồn · bao phủ cảnh báo&lt;br&gt;Thời gian · token · chi phí&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#284E68;strokeWidth=1.1;fontColor=#20384A;fontFamily=Times New Roman;fontSize=16.7;align=center;verticalAlign=middle;spacing=4;">
