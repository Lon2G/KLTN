        </mxCell>
        <mxCell id="metrics" value="&lt;b&gt;&lt;font style=&quot;font-size:18.0px&quot;&gt;Đánh giá detector đã thực hiện&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;Phân biệt giao trễ hẹn&lt;br&gt;Độ bao phủ · ổn định theo thời gian&lt;br&gt;Test với ứng viên đã cố định&lt;br&gt;Báo giới hạn và mẫu số&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#284E68;strokeWidth=1.1;fontColor=#20384A;fontFamily=Times New Roman;fontSize=16.7;align=center;verticalAlign=middle;spacing=4;">
