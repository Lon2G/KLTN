        </mxCell>
        <mxCell id="agents" value="&lt;b&gt;&lt;font style=&quot;font-size:18.0px&quot;&gt;Nhánh B · Cách tạo giải thích&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;Quy tắc / một agent / ba agent&lt;br&gt;Cùng đơn, detector và công cụ&lt;br&gt;Khai báo trần tài nguyên mỗi phương án&lt;br&gt;Đã có pilot; bộ so sánh chưa đủ&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#284E68;strokeWidth=1.1;fontColor=#20384A;fontFamily=Times New Roman;fontSize=16.7;align=center;verticalAlign=middle;spacing=4;">
