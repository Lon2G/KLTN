        <mxCell id="data" value="&lt;b&gt;&lt;font style=&quot;font-size:18.0px&quot;&gt;Nguồn đầu ra hiện có&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;Điểm và độ bao phủ công đoạn · trễ hẹn · nhóm tham chiếu · bằng chứng và giới hạn&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#EFF6F2;strokeColor=#396852;strokeWidth=1.1;fontColor=#20384A;fontFamily=Times New Roman;fontSize=16.7;align=center;verticalAlign=middle;spacing=4;">
