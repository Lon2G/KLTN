        <mxCell id="group" value="&lt;b&gt;&lt;font style=&quot;font-size:18.0px&quot;&gt;Xem nhóm cần kiểm tra&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;Theo công đoạn, seller, khu vực&lt;br&gt;Số lượng / tỷ lệ và mẫu số&lt;br&gt;Phân bố thời gian và độ bao phủ&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#946425;strokeWidth=1.1;fontColor=#20384A;fontFamily=Times New Roman;fontSize=16.7;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;">
