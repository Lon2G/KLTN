        <mxCell id="score" value="&lt;b&gt;&lt;font style=&quot;font-size:17.3px&quot;&gt;Tính chênh lệch và điểm riêng biệt&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;Δ = d − μ; Δ &amp;lt; 0: nhanh hơn tham chiếu&lt;br&gt;Nếu d ≤ μ hoặc d ≤ 0: điểm = 0&lt;br&gt;Còn lại: 100 × clip((F(d) − 0,95) / 0,05; 0; 1)&lt;br&gt;Cờ công đoạn kéo dài khi điểm &amp;gt; 0&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#284E68;strokeWidth=1.1;fontColor=#20384A;fontFamily=Times New Roman;fontSize=15.3;align=center;verticalAlign=middle;spacing=4;">
