        <mxCell id="unavailable" value="&lt;b&gt;&lt;font style=&quot;font-size:16.7px&quot;&gt;Chưa đánh giá được&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;Thiếu mốc / mâu thuẫn&lt;br&gt;Thiếu mẫu tham chiếu&lt;br&gt;Điều kiện khác không đạt&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FBF0EF;strokeColor=#98524B;strokeWidth=1.1;fontColor=#20384A;fontFamily=Times New Roman;fontSize=15.7;align=center;verticalAlign=middle;spacing=4;">
