        </mxCell>
        <mxCell id="fallback" value="&lt;b&gt;&lt;font style=&quot;font-size:18.0px&quot;&gt;2. Nhóm dự phòng cấp ngành&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;Nhóm bối cảnh có địa lý đạt điều kiện; n ≥ 30&lt;br&gt;Công khai các điều kiện đã được nới lỏng&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#284E68;strokeWidth=1.1;fontColor=#20384A;fontFamily=Times New Roman;fontSize=16.7;align=center;verticalAlign=middle;spacing=4;">
