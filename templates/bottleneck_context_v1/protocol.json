{
  "version": "bottleneck_context_v1",
  "scope": "frozen_real_olist_bed_bath_table_guarded_validation_process_signals_v1",
  "purpose": "localize_recurrent_long_stage_signals_describe_context_associations_and_propose_evidence_linked_investigation",
  "group_definitions": [
    {"dimension": "overall", "match_fields": []},
    {"dimension": "customer_state", "match_fields": ["distance_band", "seller_attribution_scope", "stage_start_month"]},
    {"dimension": "stage_start_month", "match_fields": ["customer_state", "distance_band", "seller_attribution_scope"]},
    {"dimension": "distance_band", "match_fields": []}
  ],
  "minimum_cell_target_orders": 5,
  "minimum_cell_comparator_orders": 5,
  "minimum_matched_target_orders": 30,
  "minimum_matched_comparator_orders": 30,
  "minimum_target_match_coverage": 0.8,
  "minimum_matched_signals_for_investigation": 5,
  "support_policy": "provisional_reporting_guards_declared_before_new_comparisons_not_tuned_for_accuracy_or_statistical_significance",
  "target": "unchanged_long_stage_warning_from_frozen_train_reference",
  "denominator": "assessable_distinct_orders_in_each_stage_group; unavailable_flags_are_not_negative",
  "time_definition": "calendar_month_of_observed_stage_start_not_purchase_month_for_every_stage;_source_timestamp_timezone_unspecified_no_timezone_conversion",
  "comparator": "other_group_values_in_same_stage_and_validation_snapshot; exclude_every_target_order; exact_match_on_declared_fields; no_fallback_pooling",
  "common_support": "target_cells_with_at_least_5_assessed_target_and_5_assessed_comparator_orders; missing_match_values_not_eligible",
  "weights": "target_cell_assessed_orders / total_matched_target_orders",
  "matched_target_rate": "sum(target_cell_warning_orders) / sum(target_cell_assessed_orders)",
  "matched_comparator_rate": "sum(target_cell_weight * comparator_cell_warning_orders / comparator_cell_assessed_orders)",
  "rate_difference": "matched_target_rate - matched_comparator_rate; descriptive_association_not_causal_effect",
  "investigation_candidate": "support_guards_pass and matched_target_rate > matched_comparator_rate and matched_target_warning_orders >= 5; not_confirmed_bottleneck_or_significance_test",
  "distance_view": "descriptive_only; never_rank_far_routes_as_bottlenecks_by_raw_duration_or_compare_distance_bands_as_like_for_like",
  "partial_month": "stage_start_month_containing_observation_cutoff_is_descriptive_only_and_excluded_from_comparator_pool_for_month_comparisons;state_comparisons_match_month_exactly;completed_months_can_still_have_incomplete_followup",
  "coverage": "publish_full_and_assessable_denominators_and_matched_coverage;complete_case_bias_remains",
  "calendar_lateness": "separate_delivery_outcome_with_its_own_denominator;co_occurrence_does_not_prove_stage_caused_lateness",
  "multiplicity": "overlapping_groups_and_reused_controls; exploratory_patterns_not_independent_confirmations; no_p_values_or_confidence_probabilities",
  "interpretation": "rates_of_exceeding_existing_context_specific_train_boundaries_not_common_fixed_days;even_small_positive_differences_can_be_candidates_not_proof_of_material_or_significant_change",
  "uncontrolled_context": ["seller_identity", "actual_origin_destination_route", "carrier", "service_level", "item_size_and_weight", "inventory", "staffing", "weather", "traffic", "event_arrival_times"],
  "cause_status": "operational_causes_unverified;hypotheses_and_conditional_actions_only",
  "recommendation_status": "rule_based_investigation_checklists_not_multi_agent_AI_or_proven_interventions",
  "model_trained": false,
  "threshold_changed": false,
  "reference_labels_created": 0,
  "test_scored": false,
  "independent_accuracy_computed": false,
  "near_real_time_validated": false
}
