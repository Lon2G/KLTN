{
  "version": "delivery_supplement_v1",
  "purpose": "analyst_assisted_case_comparison_not_ground_truth_or_model_selection",
  "source": "real_olist_bed_bath_table_only",
  "sample_size": 40,
  "per_group": 10,
  "selection_order": ["saved_model_disagreement", "late_promise", "long_stage_on_time", "comparison"],
  "selection_seed": "delivery-supplement-v1-2026-10-15",
  "selection_method": "sha256_seed_group_order_id_ascending_without_replacement; report_shortfall_do_not_fill_with_other_groups",
  "candidate_scope": "existing_validation_with_all_actual_milestones_visible_before_guard_and_no_source_conflict; exclude_original_120_pilot",
  "reference_scope": "existing_train_only_nonnegative_visible_stage_durations_ending_before_first_validation_purchase",
  "context_levels": [["customer_state", "distance_band", "seller_attribution_scope"], ["distance_band", "seller_attribution_scope"], ["customer_state", "seller_attribution_scope"], ["seller_attribution_scope"]],
  "minimum_reference_orders": 30,
  "empirical_percentile": "count_reference_duration_less_than_or_equal_to_case_duration_divided_by_n; not_probability",
  "long_stage_sampling_percentile": 0.95,
  "comparison_sampling_max_percentile": 0.9,
  "sampling_cutoffs": "provisional_coverage_choices_not_optimized_anomaly_thresholds_or_stage_SLAs",
  "long_stage_group": "early_or_on_date_and_any_stage_percentile_gt_0.95_with_distance_matched_reference",
  "comparison_group": "early_or_on_date_all_three_stage_percentiles_le_0.9_and_all_12_saved_configurations_evaluated_without_long_short_or_zero_warnings; not_confirmed_normal",
  "saved_models": "12_historical_contextual_interval_configurations_same_transport_target; not_12_algorithm_families_or_all_anomaly_detectors",
  "disagreement": "at_least_one_long_warning_and_one_no_long_warning_for_the_same_observed_transport_duration; not_majority_vote",
  "history_limit": "saved_models_are_exploratory_historical_results_not_new_leakage_free_pre_guard_experiment",
  "context_limit": "straight_line_ZIP_distance_not_route; no_carrier_service_level_weather_traffic_or_per_item_stage_timestamps; no_causal_attribution",
  "labels": "calendar_performance_and_source_observations_only; broad_anomaly_unresolved; no_invented_human_or_advisor_labels",
  "review_exposure": "analyst_assisted_not_blind; later_labels_require_independent_evidence_and_exposure_audit",
  "population_inference": "purposive_balanced_groups_not_population_prevalence_or_unbiased_accuracy_sample",
  "missing": "unknown_not_zero_or_normal",
  "final_test": "no_feature_reads_or_scoring; existing_guard_not_activation_of_proposed_split",
  "external_import_needed_for_this_step": false
}
