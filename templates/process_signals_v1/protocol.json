{
  "version": "process_signals_v1",
  "scope": "real_olist_bed_bath_table_guarded_validation_from_evidence_criteria_v1",
  "purpose": "detect_and_localize_observed_signals_without_requiring_root_cause",
  "primary_signals": ["calendar_late", "long_stage"],
  "secondary_information": ["positive_short_stage", "zero_recorded_stage", "early_delivery", "on_date_delivery"],
  "working_upper_percentile": 0.95,
  "working_lower_percentile": 0.05,
  "threshold_status": "unchanged_provisional_rule_not_optimized_detector",
  "ecdf": "F(d) = count(train_reference_duration <= d) / reference_n",
  "long_rule": "assessable and duration_days > 0 and F(duration_days) > working_upper_percentile",
  "short_note_rule": "assessable and duration_days > 0 and F(duration_days) < working_lower_percentile",
  "exact_day_boundaries": "upper = first ordered reference value with rank/n > upper percentile, comparison >=; lower = first ordered reference value with rank/n >= lower percentile, comparison <; positive-duration restriction also applies",
  "display_p95": "linear_interpolated_descriptive_quantile_not_the_exact_ecdf_decision_boundary",
  "stage_eligibility": "inherit_frozen_parent_complete_timing_and_context_policy; missing_comparison_is_not_no_warning",
  "reference": "train_only_before_first_validation; minimum_30_and_quality_screened_distance_match; not_verified_normal_cases",
  "partial_aggregation": "any_observed_warning_is_true; false_requires_all_three_stages_assessed; otherwise_unknown",
  "cause_required_for_detection": false,
  "cause_required_for_signal_reference_label": false,
  "root_cause_attribution": "out_of_scope_no_seller_blame_or_fraud_claim",
  "evaluation_target": "usefulness_and_correctness_of_declared_signals_and_stage_localization_not_operational_cause",
  "independent_signal_reference": "may_be_reviewed_from_recorded_evidence_and_predeclared_context_criteria; does_not_require_knowing_why_delay_occurred",
  "rule_agreement": "not_independent_anomaly_accuracy; do_not_grade_a_rule_against_its_own_labels",
  "deployment_selection": "provisional_configuration_possible_with_explicit_operational_criteria; most_accurate_claim_requires_appropriate_independent_evaluation",
  "limitations": "retrospective_complete_case_context_policy; straight_line_ZIP_distance_not_route; no_full_control_for_item_size_carrier_service_weather_or_seasonality",
